{
  "expo": {
    "name": "DocBolso",
    "slug": "docbolso",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.alexandre.docbolso"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.alexandre.docbolso",
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.WRITE_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Usar o Face ID para desbloquear seus documentos."
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Usar o Face ID para desbloquear seus documentos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Escolher fotos dos seus documentos.",
          "cameraPermission": "Fotografar seus documentos.",
          "microphonePermission": false
        }
      ]
    ],
    "scheme": "docbolso",
    "experiments": {
      "typedRoutes": true
    }
  }
}
